<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="API Keys (gratis, daftarkan dulu)" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginBottom="10dp"
            android:textAllCaps="true" android:letterSpacing="0.1"/>

        <!-- POLLINATIONS NOTE -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="✅ Pollinations.AI — tanpa API key (otomatis digunakan)"
            android:textSize="13sp" android:textColor="#2EA043"
            android:background="@drawable/bg_card" android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Gemini API Key (aistudio.google.com — gratis)" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etGeminiKey" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="AIzaSy..."
            android:inputType="textPassword" android:background="@drawable/bg_input"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
            android:padding="12dp" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Groq API Key (console.groq.com — gratis)" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etGroqKey" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="gsk_..."
            android:inputType="textPassword" android:background="@drawable/bg_input"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
            android:padding="12dp" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Mistral API Key (console.mistral.ai — gratis)" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etMistralKey" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="..."
            android:inputType="textPassword" android:background="@drawable/bg_input"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
            android:padding="12dp" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cohere API Key (dashboard.cohere.com — gratis)" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etCohereKey" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="..."
            android:inputType="textPassword" android:background="@drawable/bg_input"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
            android:padding="12dp" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Together AI Key (api.together.ai — gratis)" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etTogetherKey" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="..."
            android:inputType="textPassword" android:background="@drawable/bg_input"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
            android:padding="12dp" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="OpenAI API Key (platform.openai.com — berbayar)" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etOpenaiKey" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="sk-..."
            android:inputType="textPassword" android:background="@drawable/bg_input"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
            android:padding="12dp" android:layout_marginBottom="20dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Provider Aktif" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spinnerProvider" android:layout_width="match_parent"
            android:layout_height="48dp" android:background="@drawable/bg_input"
            android:padding="12dp" android:layout_marginBottom="20dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Nilai KKM"
                android:textColor="@color/text_primary" android:textSize="14sp"/>
            <EditText android:id="@+id/etKkm" android:layout_width="80dp"
                android:layout_height="wrap_content" android:inputType="number"
                android:text="75" android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" android:padding="10dp"
                android:gravity="center"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Mode Samaran (sembunyikan status AI)"
                android:textColor="@color/text_primary" android:textSize="14sp"/>
            <Switch android:id="@+id/switchStealth" android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Jawab dalam Bahasa Indonesia"
                android:textColor="@color/text_primary" android:textSize="14sp"/>
            <Switch android:id="@+id/switchBahasaIndo" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checked="true"/>
        </LinearLayout>

        <Button android:id="@+id/btnTestProvider" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="Test Provider"
            android:backgroundTint="@color/surface2" android:layout_marginBottom="10dp"/>

        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="52dp" android:text="Simpan Pengaturan"
            android:backgroundTint="@color/accent_blue"/>

    </LinearLayout>
</ScrollView>
