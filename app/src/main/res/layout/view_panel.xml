<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:padding="16dp"
    android:elevation="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🤖 AuraAI"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <!-- Stealth toggle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Samaran"
            android:textSize="11sp"
            android:textColor="#8B949E"
            android:layout_marginEnd="6dp"/>

        <Switch
            android:id="@+id/switchStealth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"/>

        <Button
            android:id="@+id/btnClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="✕"
            android:textSize="12sp"
            android:padding="0dp"
            android:backgroundTint="#30363D"/>
    </LinearLayout>

    <!-- INPUT SOAL -->
    <EditText
        android:id="@+id/etQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Paste soal ujian di sini..."
        android:minHeight="80dp"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:maxLines="5"
        android:background="@drawable/bg_input"
        android:textColor="#E6EDF3"
        android:textColorHint="#8B949E"
        android:textSize="13sp"
        android:padding="12dp"
        android:layout_marginBottom="10dp"/>

    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btnAnswerThis"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.4"
            android:text="✨ Jawab"
            android:textSize="12sp"
            android:backgroundTint="#1458B8"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnExplain"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="📖 Jelaskan"
            android:textSize="12sp"
            android:backgroundTint="#1C2333"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="0.6"
            android:text="🗑"
            android:textSize="14sp"
            android:backgroundTint="#1C2333"/>
    </LinearLayout>

    <!-- PROGRESS -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:progressTint="#00B4D8"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <!-- STATUS -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ketik atau paste soal di atas"
        android:textSize="11sp"
        android:textColor="#8B949E"
        android:layout_marginBottom="8dp"/>

    <!-- ANSWER OUTPUT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp">

        <TextView
            android:id="@+id/tvAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_answer"
            android:padding="12dp"
            android:textColor="#E6EDF3"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textIsSelectable="true"/>
    </ScrollView>

</LinearLayout>
